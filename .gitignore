# Keep this repository focused on the two applications.
# Workspace notes, local tools, archives and research stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/.github/
!/zhitu/
!/backend/

# Dependencies and generated output
node_modules/
dist/
dist-ssr/
coverage/
__pycache__/
*.pyc
*.log

# Local configuration; commit placeholder templates only.
.env
.env.*
!.env.example

# Local credentials
*.pem
*.key
*.p12
*.pfx

.DS_Store

# Native module runtime state
.venv/
.pytest_cache/
.ruff_cache/
.next/
.next-website/
.turbo/
.boss_profile/
.deepinterview/
.local-preview/
*.sqlite*
*.db
*.db-wal
*.db-shm
*.tsbuildinfo
test-results/
playwright-report/
