# Copy to .env, then fill in local values. Never commit .env.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zhitu

# Set independent random secrets before starting a new environment.
# Existing installations must retain their existing encryption secret.
JWT_SECRET=
JWT_REFRESH_SECRET=
MODEL_CONFIG_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_SESSION_MAX_AGE=7d
REFRESH_TOKEN_COOKIE_NAME=refreshToken
REFRESH_COOKIE_SAMESITE=lax

# Redis: REDIS_URL takes precedence over host/port when configured.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Optional AI summary / keywords and web search
SUMMARY_DEEPSEEK_API_KEY=
ARTICLE_ABSTRACT_DEEPSEEK_API_KEY=
ARTICLE_ABSTRACT_DEEPSEEK_MODEL=
ARTICLE_ABSTRACT_DEEPSEEK_BASE_URL=https://api.deepseek.com
BOCHA_API_KEY=

# Optional OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/oauth/google/callback
