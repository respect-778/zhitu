# Documentation only; the application does not automatically read .env files.
# Optional API port; the default bind address is 127.0.0.1.
CATALOG_API_PORT=5198
# Isolated Linux containers only; requires CATALOG_DATABASE_ENDPOINT=container.
# CATALOG_API_BIND=container

# Only approved dedicated local/test endpoints are accepted. No automatic .env loading.
# API receives reader credentials only. Separate ingest/publish processes require catalog_writer;
# migrations require catalog_migrator. Do not give the API those credentials.
CATALOG_DATABASE_ENDPOINT=local
CATALOG_DATABASE_URL=postgresql://catalog_reader:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:55432/knowvia_catalog_test
# Explicitly enables database integration tests; default catalog:test skips that suite.
CATALOG_DB_TEST=0
